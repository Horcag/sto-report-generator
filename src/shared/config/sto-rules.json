{
	"metadata": {
		"standard": "STO 02068410-004-2019 and extracted local STO/GOST notes",
		"references": [
			"STO 02068410-004-2019",
			"Rules for Russian academic lists, bibliography and formulas"
		],
		"purpose": "Shared STO constants for generator formatting, parser guards and validators"
	},
	"markdown": {
		"structuralHeadingCommand": "sto_structural_heading",
		"supportedEnvironments": ["sto_bibliography", "sto_list", "sto_enum"],
		"listEnvironments": ["sto_list", "sto_enum"],
		"bibliographyEnvironment": "sto_bibliography",
		"sourcesStructuralHeading": "СПИСОК ИСПОЛЬЗОВАННЫХ ИСТОЧНИКОВ"
	},
	"typography": {
		"fontFamily": "Times New Roman",
		"fontSizePoints": 14,
		"fontSizeHalfPoints": 28,
		"fontColor": "000000",
		"normalLineSpacingDxa": 360,
		"captionLineSpacingDxa": 240,
		"firstLineIndentDxa": 709,
		"nestedListIndentStepDxa": 709,
		"captionFirstLineIndentDxa": 0,
		"forbiddenDash": "—",
		"recommendedDash": "–",
		"listMarker": "-"
	},
	"page": {
		"marginsDxa": {
			"top": 1134,
			"bottom": 1134,
			"left": 1701,
			"right": 850
		},
		"imageMaxWidthEmu": 5040000
	},
	"headings": {
		"structuralNoTocUppercase": ["РЕФЕРАТ", "СОДЕРЖАНИЕ"],
		"requiredStructuralUppercase": [
			"РЕФЕРАТ",
			"СОДЕРЖАНИЕ",
			"ВВЕДЕНИЕ",
			"ЗАКЛЮЧЕНИЕ",
			"СПИСОК ИСПОЛЬЗОВАННЫХ ИСТОЧНИКОВ"
		]
	},
	"referat": {
		"fileName": "01_referat.md",
		"statisticPlaceholders": [
			"{{PAGES}}",
			"{{FIGURES}}",
			"{{TABLES}}",
			"{{SOURCES}}"
		],
		"keywordCount": {
			"min": 5,
			"max": 15
		},
		"semanticMarkers": ["Объект", "Цель", "результат"],
		"maxTextLengthChars": 850
	},
	"lists": {
		"forbiddenRussianLetterMarkers": [
			"ё",
			"з",
			"й",
			"о",
			"ч",
			"ъ",
			"ы",
			"ь"
		],
		"introTrailingPrepositions": [
			"в",
			"во",
			"на",
			"к",
			"по",
			"для",
			"о",
			"об",
			"с",
			"со"
		],
		"markerPolicies": {
			"parenthesized": {
				"nonFinalLowercaseEndings": [";", ","],
				"finalEndings": ["."]
			},
			"dotted": {
				"requireUppercaseStart": true,
				"itemEndings": ["."]
			}
		}
	},
	"tables": {
		"discouragedOrdinalHeaders": ["№ п/п", "Номер по порядку"]
	},
	"formulas": {
		"forbiddenSourceMultiplicationSigns": ["*", "·"],
		"uprightFunctions": [
			"sin",
			"cos",
			"tan",
			"arcsin",
			"arccos",
			"arctan",
			"sh",
			"ch",
			"ln",
			"lg",
			"log",
			"max",
			"min",
			"lim",
			"exp",
			"const"
		],
		"forbiddenRawTokens": ["..."],
		"lineBreakOperators": {
			"repeatRequired": [
				"=",
				"≈",
				"<",
				">",
				"≤",
				"≥",
				"+",
				"-",
				"−",
				"\\times"
			],
			"forbiddenBeforeBreak": ["/", ":", "\\div"]
		}
	},
	"bibliography": {
		"urlProtocols": ["http", "https", "ftp"],
		"urldatePattern": "^\\d{4}-\\d{2}-\\d{2}$",
		"requiredFieldsByType": {
			"book": [
				["title"],
				["author", "editor"],
				["year"],
				["address", "location"],
				["publisher"],
				["pages", "numpages"]
			],
			"article": [
				["title"],
				["author"],
				["journal"],
				["year"],
				["pages"]
			],
			"inproceedings": [
				["title"],
				["author", "editor"],
				["booktitle"],
				["address", "location"],
				["year"],
				["pages"]
			],
			"incollection": [
				["title"],
				["author", "editor"],
				["booktitle"],
				["address", "location"],
				["year"],
				["pages"]
			],
			"misc": [["title"], ["year"], ["url"]],
			"online": [["title"], ["year"], ["url"]],
			"techreport": [["title"], ["author", "institution"], ["year"]]
		}
	},
	"documentStructure": {
		"requiredOrder": [
			"РЕФЕРАТ",
			"СОДЕРЖАНИЕ",
			"ВВЕДЕНИЕ",
			"ЗАКЛЮЧЕНИЕ",
			"СПИСОК ИСПОЛЬЗОВАННЫХ ИСТОЧНИКОВ"
		]
	},
	"validation": {
		"allowedBoldMarkdownFiles": ["01_referat.md"],
		"forbiddenLiteralMarkers": [
			"Источник не найден",
			"Source not found",
			"NOT FOUND"
		],
		"figureCaptionPrefix": "Рисунок",
		"tableCaptionPrefix": "Таблица",
		"manualCitationNumberPattern": "\\[(?:[1-9]\\d*)(?:\\s*,\\s*[1-9]\\d*)*\\]"
	}
}
