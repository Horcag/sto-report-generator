{
	"name": "sto-report-generator",
	"version": "1.0.0",
	"description": "Generates docx reports complying with university STO requirements from Markdown",
	"main": "index.js",
	"scripts": {
		"unpack": "uv run python .agents/skills/docx/scripts/office/unpack.py",
		"lint": "eslint \"src/**/*.ts\" \"tests/**/*.ts\"",
		"lint:fix": "eslint \"src/**/*.ts\" \"tests/**/*.ts\" --fix",
		"format": "prettier --write --no-error-on-unmatched-pattern --ignore-unknown \"{src,tests}/**/*.{ts,json}\" \"package.json\" \"tsconfig.json\" \"README.md\" \"docs/**/*.md\" \"*.config.{js,mjs,ts}\" \".*rc\" \".pre-commit-config.yaml\" \".github/**/*.yml\" \"sonar-project.properties\"",
		"format:check": "prettier --check --no-error-on-unmatched-pattern --ignore-unknown \"{src,tests}/**/*.{ts,json}\" \"package.json\" \"tsconfig.json\" \"README.md\" \"docs/**/*.md\" \"*.config.{js,mjs,ts}\" \".*rc\" \".pre-commit-config.yaml\" \".github/**/*.yml\" \"sonar-project.properties\"",
		"typecheck": "tsc --noEmit",
		"fsd:check": "steiger ./src",
		"fsd:fix": "steiger ./src --fix",
		"build": "npx tsx src/index.ts build",
		"new:report": "npx tsx src/index.ts new",
		"check:source": "npx tsx src/index.ts check",
		"generate:report": "npx tsx src/index.ts generate",
		"validate:sto": "npx tsx src/shared/lib/sto-validator.ts",
		"validate:docx": "npx tsx src/index.ts validate-docx",
		"generate": "npx tsx src/index.ts generate reports/report_sem6 --output output/report_sem6.docx --post-build --validate",
		"build:example": "npx tsx tests/regression_checks.ts example && npx tsx src/index.ts build example example/output.docx && uv run python scripts/post_build.py example/output.docx example",
		"build:example:raw": "npx tsx tests/regression_checks.ts example && npx tsx src/index.ts build example .agent-work/example-raw.docx",
		"test": "npx tsx tests/run_all_tests.ts",
		"test:source": "npx tsx tests/run_source_preflight_tests.ts && npx tsx tests/regression_checks.ts example",
		"test:parser": "npx tsx tests/run_parser_tests.ts",
		"test:validator": "npx tsx tests/run_validator_tests.ts",
		"test:generated-docx": "npx tsx tests/run_generated_docx_validation.ts",
		"test:scaffold": "npx tsx tests/run_scaffold_tests.ts",
		"test:generator": "npx tsx tests/run_generator_snapshot_test.ts",
		"test:toc": "npx tsx tests/toc_regression.ts",
		"test:bib": "npx tsx tests/bib-gost.test.ts",
		"ci:check": "npm run lint -- --max-warnings=0 && npm run typecheck && npm run fsd:check && npm test",
		"quality": "npm run format:check && npm run ci:check",
		"hooks:install": "uv run pre-commit install --hook-type pre-commit --hook-type pre-push",
		"hooks:run": "uv run pre-commit run --all-files",
		"hooks:push": "uv run pre-commit run --hook-stage pre-push --all-files"
	},
	"keywords": [],
	"author": "",
	"license": "ISC",
	"type": "commonjs",
	"dependencies": {
		"@hungknguyen/mathml2omml": "^0.4.6",
		"@orcid/bibtex-parse-js": "^0.0.25",
		"adm-zip": "^0.5.17",
		"docx": "^9.6.1",
		"gray-matter": "^4.0.3",
		"image-size": "^2.0.2",
		"jsdom": "^23.2.0",
		"marked": "^18.0.2",
		"mathjax": "^3.2.2",
		"tsconfig-paths": "^4.2.0"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@feature-sliced/steiger-plugin": "^0.5.7",
		"@ianvs/prettier-plugin-sort-imports": "^4.7.1",
		"@types/adm-zip": "^0.5.8",
		"@types/image-size": "^0.7.0",
		"@types/jsdom": "^21.1.7",
		"@types/node": "^25.6.0",
		"eslint": "^10.2.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-prettier": "^5.5.5",
		"globals": "^17.5.0",
		"prettier": "^3.8.3",
		"steiger": "^0.5.11",
		"ts-node": "^10.9.2",
		"tsx": "^4.21.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.59.0"
	}
}
