{
	"name": "sto-report-generator",
	"version": "1.0.0",
	"description": "Generates docx reports complying with university STO requirements from Markdown",
	"private": true,
	"files": [
		"src",
		"scripts",
		"docs",
		"example/*.md",
		"example/*.bib",
		"example/images",
		"LICENSE",
		"README.md",
		"tsconfig.json",
		"pyproject.toml",
		"uv.lock"
	],
	"scripts": {
		"unpack": "uv run python .agents/skills/docx/scripts/office/unpack.py",
		"lint": "eslint \"src/**/*.ts\" \"tests/**/*.ts\"",
		"lint:fix": "eslint \"src/**/*.ts\" \"tests/**/*.ts\" --fix",
		"format": "prettier --write --no-error-on-unmatched-pattern --ignore-unknown \"{src,tests}/**/*.{ts,json}\" \"package.json\" \"tsconfig.json\" \"README.md\" \"docs/**/*.md\" \"tests/**/*.md\" \"*.config.{js,mjs,ts,yaml}\" \".*rc\" \".pre-commit-config.yaml\" \".github/**/*.yml\" \"sonar-project.properties\"",
		"format:check": "prettier --check --no-error-on-unmatched-pattern --ignore-unknown \"{src,tests}/**/*.{ts,json}\" \"package.json\" \"tsconfig.json\" \"README.md\" \"docs/**/*.md\" \"tests/**/*.md\" \"*.config.{js,mjs,ts,yaml}\" \".*rc\" \".pre-commit-config.yaml\" \".github/**/*.yml\" \"sonar-project.properties\"",
		"typecheck": "tsc --noEmit",
		"fsd:check": "steiger ./src",
		"fsd:fix": "steiger ./src --fix",
		"build": "npx tsx src/index.ts build",
		"new:report": "npx tsx src/index.ts new",
		"check:source": "npx tsx src/index.ts check",
		"generate:report": "npx tsx src/index.ts generate",
		"audit:report": "npx tsx src/index.ts audit",
		"accept:word": "npx tsx src/index.ts accept-word",
		"validate:sto": "npx tsx src/shared/lib/sto-validator.ts",
		"validate:docx": "npx tsx src/index.ts validate-docx",
		"doctor": "npx tsx src/index.ts doctor",
		"generate": "npx tsx src/index.ts generate reports/report_sem6 --output output/report_sem6.docx --renderer portable --validate",
		"build:example": "npx tsx tests/source-preflight/regression_checks.ts example && npx tsx src/index.ts build example example/output.docx && uv run python scripts/post_build.py example/output.docx example",
		"build:example:raw": "npx tsx tests/source-preflight/regression_checks.ts example && npx tsx src/index.ts build example .agent-work/example-raw.docx",
		"test": "npx tsx tests/run_all_tests.ts",
		"test:source": "npx tsx tests/source-preflight/run_source_preflight_tests.ts && npx tsx tests/source-preflight/regression_checks.ts example",
		"test:parser": "npx tsx tests/parser/run_parser_tests.ts",
		"test:validator": "npx tsx tests/validator/run_validator_tests.ts",
		"test:generated-docx": "npx tsx tests/generator/run_generated_docx_validation.ts",
		"test:scaffold": "npx tsx tests/scaffold/run_scaffold_tests.ts",
		"test:generator": "npx tsx tests/generator/run_generator_snapshot_test.ts",
		"test:toc": "npx tsx tests/generator/toc_regression.ts",
		"test:bib": "npx tsx tests/bibliography/bib-gost.test.ts",
		"test:coverage": "npx tsx scripts/quality/run_coverage.ts",
		"test:quality-policy": "uv run python -m unittest discover -s scripts/quality/tests -p \"test_*.py\" && uv run python -m unittest discover -s tests/quality -p \"test_*.py\"",
		"check:pack": "npx tsx tests/package/run_pack_content_check.ts",
		"check:file-size": "uv run python scripts/quality/check_file_size.py",
		"check:markdown-links": "uv run python scripts/quality/check_markdown_links.py --root .",
		"check:spelling": "cspell lint --no-progress --show-suggestions README.md \"docs/**/*.md\"",
		"security:audit": "npm audit --audit-level=low",
		"python:format": "uv run ruff format scripts tests/quality",
		"python:format:check": "uv run ruff format --check scripts tests/quality",
		"python:lint": "uv run ruff check scripts tests/quality",
		"python:lint:fix": "uv run ruff check --fix scripts tests/quality",
		"python:typecheck": "uv run mypy scripts",
		"python:quality": "npm run python:format:check && npm run python:lint && npm run python:typecheck",
		"ci:check": "npm run format:check && npm run lint -- --max-warnings=0 && npm run typecheck && npm run fsd:check && npm run test:quality-policy && npm run test:coverage && npm run check:pack && npm run check:file-size && npm run check:markdown-links && npm run check:spelling && npm run security:audit",
		"quality": "npm run ci:check && npm run python:quality",
		"quality:clean-index": "uv run python scripts/quality/run_clean_index_quality.py",
		"hooks:install": "uv run pre-commit install --hook-type pre-commit --hook-type pre-push",
		"hooks:run": "uv run pre-commit run --all-files",
		"hooks:push": "uv run pre-commit run --hook-stage pre-push --all-files"
	},
	"keywords": [],
	"author": "",
	"license": "ISC",
	"type": "commonjs",
	"dependencies": {
		"@hungknguyen/mathml2omml": "^0.4.6",
		"@orcid/bibtex-parse-js": "^0.0.25",
		"adm-zip": "0.6.1",
		"docx": "9.7.1",
		"gray-matter": "^4.0.3",
		"image-size": "2.0.4",
		"jsdom": "30.1.0",
		"marked": "^18.0.13",
		"mathjax": "4.1.3",
		"tsconfig-paths": "^4.2.0"
	},
	"devDependencies": {
		"@cspell/dict-ru_ru": "2.3.2",
		"@eslint/js": "^10.0.1",
		"@feature-sliced/steiger-plugin": "^0.7.0",
		"@ianvs/prettier-plugin-sort-imports": "^4.7.1",
		"@types/adm-zip": "^0.5.8",
		"@types/jsdom": "^30.0.0",
		"@types/node": "^24.13.6",
		"c8": "12.0.0",
		"cspell": "10.3.3",
		"eslint": "^10.10.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-prettier": "^5.5.6",
		"globals": "^17.12.0",
		"prettier": "^3.9.8",
		"steiger": "^0.6.0",
		"ts-node": "^10.9.2",
		"tsx": "4.23.15",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.70.0"
	}
}
